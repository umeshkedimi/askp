# ---- Go ----
# Compiled binary produced by `go build` at the repo root.
/askp
# Test binaries and profiling output.
*.test
*.out
coverage.out
# Go workspace file (machine-local; not committed).
go.work
go.work.sum
# If we ever vendor dependencies, that directory is generated.
/vendor/

# ---- Environment & secrets (NEVER commit) ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/
*.local

# ---- Databases / data ----
*.sqlite3
*.db

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Docs build ----
site/
docs/_build/

# ---- Node (for JS SDK in later batches) ----
node_modules/
npm-debug.log*
yarn-error.log*
