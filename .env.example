# ASKP configuration — copy to `.env` and adjust. All vars are prefixed ASKP_.
# `.env` is gitignored; never commit real secrets.

# --- Service identity ---
ASKP_APP_NAME=askp
ASKP_ENVIRONMENT=development        # development | staging | production

# --- HTTP server ---
ASKP_HOST=127.0.0.1
ASKP_PORT=8000

# --- Observability ---
ASKP_LOG_LEVEL=info                 # debug | info | warning | error
# ASKP_LOG_JSON=true                # force JSON logs (default: JSON unless development)

# --- Datastores (used from Increment 1 onward) ---
ASKP_DATABASE_URL=postgresql+asyncpg://askp:askp@localhost:5432/askp
ASKP_REDIS_URL=redis://localhost:6379/0
