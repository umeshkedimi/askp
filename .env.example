# ASKP configuration — copy to `.env` and adjust. All vars are prefixed ASKP_.
# `.env` is gitignored; never commit real secrets.

# --- Service identity ---
ASKP_APP_NAME=askp
ASKP_ENVIRONMENT=development        # development | staging | production

# --- HTTP server ---
ASKP_HOST=127.0.0.1
ASKP_PORT=8000

# --- Observability ---
ASKP_LOG_LEVEL=info                 # debug | info | warning | error
ASKP_LOG_FORMAT=auto                # json | console | auto (auto = json unless development)

# Datastore and secret configuration (database, Redis, signing keys, vault KEK, admin
# auth) lands starting with Increment 1 of the Python reference implementation.
